# Arcwell Server Environment File

# Instance Configuration:
ARCWELL_INSTANCE_NAME="Development Arcwell Server"
ARCWELL_INSTANCE_ID=arcweb-dev
ARCWELL_REGISTER_ENABLED=true
ARCWELL_SERVER_CORS_ORIGINS=http://localhost:4200,0.0.0.0:4200,127.0.0.1:4200,http://localhost:3333,http://localhost:4000,capacitor://localhost,http://localhost

# Mail Delivery:
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=arcwell
SMTP_PASSWORD=arcwell
SMTP_FROM_ADDRESS=arcwell@example.com
SMTP_FROM_NAME="Arcwell Admin"

# Server Config:
TZ=UTC
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info
APP_KEY=$__APP_KEY__
NODE_ENV=development

# Database Connection:
DB_HOST=db
DB_PORT=5432
DB_USER=arcwell
DB_PASSWORD=arcwell
DB_DATABASE=arcwell
